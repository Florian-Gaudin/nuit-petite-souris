{
  "name": "nuit-petite-souris",
  "private": true,
  "version": "0.1.0",
  "description": "La nuit de la Petite Souris, version personnalisable : l'histoire de Quenotte racontée pour chaque enfant.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verifier": "svelte-check --tsconfig ./tsconfig.json",
    "cap:sync": "vite build && cap sync",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:tout": "npm run verifier && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "lz-string": "^1.5.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
